# ============================================================
# Makefile สำหรับ GINDER (Windows / MinGW)
# วิธีใช้บน Windows (เปิด Command Prompt หรือ PowerShell):
#   mingw32-make        → Compile และสร้างไฟล์ GINDER.exe
#   mingw32-make run    → Compile แล้วรันทันที
#   mingw32-make clean  → ลบไฟล์ GINDER.exe ที่ build ไว้
# ============================================================

TARGET  = GINDER.exe
CXX     = g++
CXXFLAGS = -std=c++17 -Wall

# Paths สำหรับ Windows
INCLUDES = -I include -I raylib/src
LIBS     = -L lib -lraylib -lgdi32 -lwinmm

SRCS = cpp/main.cpp cpp/LL.cpp cpp/Restaurant.cpp cpp/User.cpp cpp/Location.cpp

# ============================================================
# Rules
# ============================================================

all: $(TARGET)

$(TARGET): $(SRCS)
	$(CXX) $(CXXFLAGS) $(SRCS) $(INCLUDES) $(LIBS) -o $(TARGET)
	@echo "Build complete -> $(TARGET)"

run: $(TARGET)
	$(TARGET)

clean:
	del $(TARGET)

.PHONY: all run clean
